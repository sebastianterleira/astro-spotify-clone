---
import { getAllPlaylists } from "@services/service.getAllPlaylists";
import { getCurrentUser } from "@services/service.getCurrentUser";
import PlaylistsHome from "@components/supcomponents/PlaylistsHome.astro";
import Header from "@components/Header";
import GreetingTitle from "./GreetingTitle";
import RecomendedPlaylists from "./supcomponents/RecomendedPlaylists.astro";

const hash = Astro.cookies.get("token");
const token = hash.value.substring(1).split("&")[0].split("=")[1];

// Lista de Playlists
const { items } = await getAllPlaylists(token);

// Obtener la informacion del usuario actual
const user = await getCurrentUser(token);
---

<Fragment>
  <div class="wrapper">
    <Header user={user} bg={"bg__header--home"} active={false} client:load/>
    <div class="mask__bg"></div>
    {
      items && items.length > 0 ? (
      <article class="home__pov">
      <GreetingTitle client:visible />
      <div class="card__container">
        <RecomendedPlaylists items={items}/>
      </div>
    </article>
    <article class="container__grid">
      <h2 class="wave--grid">Hecho para {user.display_name}</h2>
      <div class="container__playlist">
        <PlaylistsHome items={items}/>
      </div>
    </article>
      ) : (
        <div class="no__playlists__container">
          <p class="no__playlists">No hay playlists para mostrar 😢, agrega algun playlist desde tu cuenta de <a href="https://open.spotify.com" target="_blank" rel="noopener noreferrer" class="no__playlists--link">spotify</a> para poder usar esta app</p>
        </div>
      )
    }
  </div>
</Fragment>

<style>
  :root {
    --background-noise--home: url(data:image/svg+xml;base64,);
    --background-base: #121212;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    position: relative;
  }

  .mask__bg {
    background-color: rgb(136, 24, 48);
    background-image: -webkit-gradient(linear,left top,left bottom,from(rgba(0,0,0,.6)),to(var(--background-base))),var(--background-noise--home);
    background-image: linear-gradient(rgba(0,0,0,.6) 0,var(--background-base) 100%),var(--background-noise--home);
    height: 332px;
    top: 0;
    right: 0;
    position: absolute;
    -webkit-transition: background 1s ease;
    transition: background 1s ease;
    width: 100%;
    z-index: 0;
  }

  .container__grid {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    margin-bottom: 1rem;
    position: relative;
    padding: 0 1.375rem;
  }

  .container__playlist {
    display: grid;
    /* grid-template-columns: repeat(4,1fr); */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-width: 372px;
    grid-template-rows: 17rem;
    grid-auto-rows: 17rem;
    grid-gap: 1.5rem;
    align-items: center;
    grid-area: playlist;
  }

  .wave {
    font-size: 1.95em;
    font-weight: 700;
    letter-spacing: -1px;
    user-select: none;
    -webkit-user-select: none;
  }

  .wave--grid {
    grid-area: title;
    font-size: 1.5em;
    font-weight: 700;
    letter-spacing: -1px;
    user-select: none;
    -webkit-user-select: none;
  }

  .home__pov {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    margin-bottom: 2.5rem;
    position: relative;
    padding: 0 1.375rem;
  }

  .card__container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 3rem;
    grid-auto-rows: 3rem;
    grid-gap: 0.5rem;
  }

  .no__playlists__container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 0.5rem;
    color: #fff;
    z-index: 2;
    padding: 2rem;
  }

  .no__playlists {
    font-size: 3.5em;
    font-weight: 800;
    user-select: none;
    -webkit-user-select: none;
    text-transform: uppercase;
  }

  .no__playlists--link {
    color: #1db954;
  }
</style>
